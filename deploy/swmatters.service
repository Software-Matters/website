# /etc/systemd/system/swmatters.service
[Unit]
Description=Software Matters website backend (contact form)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/swmatters
EnvironmentFile=/var/www/swmatters/.env
# A private Unix socket instead of a TCP port, so it can never clash with other apps on this server.
# systemd creates /run/swmatters (owned by www-data) on start; nginx (also www-data) connects to it.
RuntimeDirectory=swmatters
ExecStart=/var/www/swmatters/venv/bin/gunicorn --workers 2 --bind unix:/run/swmatters/gunicorn.sock --access-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
