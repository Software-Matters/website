# /etc/systemd/system/swmatters.service
[Unit]
Description=Software Matters website backend (contact form)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/swmatters
EnvironmentFile=/opt/swmatters/.env
ExecStart=/opt/swmatters/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
