# Copy to .env and fill in. Never commit .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@swmatters.com
SMTP_PASS=change-me
# starttls (usually port 587) or ssl (usually port 465)
SMTP_TLS=starttls

MAIL_TO=contact@swmatters.com
# Must be an address your SMTP provider is allowed to send as (SPF/DKIM).
MAIL_FROM=Software Matters Website <website@swmatters.com>

# ClickUp personal API token (Settings > Apps) and the target list's ID
CLICKUP_TOKEN=pk_xxxxxxxx
CLICKUP_LIST_ID=123456789

# OpenAI API key for lead qualification (platform.openai.com > API keys).
# If unset, every submission is treated as a lead.
OPENAI_API_KEY=sk-xxxxxxxx
# Optional model override (default: gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna

# Optional: where the spam-memory database lives (default: ./data/submissions.db)
# DB_PATH=/opt/swmatters/data/submissions.db
